# Copy this file to Frontend/.env and fill in the values.
# Frontend/.env is gitignored and must never be committed.

# Backend API Server URL
VITE_API_URL=http://localhost:5000

# Set to true for offline mock adapter, false to connect to the live backend
VITE_USE_MOCK=false

# Google OAuth Web Client ID (Google Cloud Console)
# Authorized JavaScript origins: http://localhost:5173
# Authorized redirect URIs: http://localhost:5173
#VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com