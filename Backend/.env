PORT=5000
NODE_ENV=development

# MongoDB Atlas or local MongoDB URI
MONGO_URI=/sahayog_db

# JWT Authentication
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Cloudinary Configuration
# (Add your Cloudinary credentials from cloudinary.com dashboard; if left blank, base64 data-URI fallback is used automatically)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Frontend Client URL
CLIENT_URL=http://localhost:5173

# AI Model Integration (Optional Gemini / OpenAI key; smart heuristic NLP fallback active if blank)
AI_API_KEY=
