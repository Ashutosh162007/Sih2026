# ==========================================
# Sahayog Backend Environment Configuration
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB Atlas / Local MongoDB)
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/sahayog_db?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_here_sahayog_2026
JWT_EXPIRES_IN=7d

# Google OAuth 2.0 (Google Identity Services)
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# OTP & Email Verification
OTP_SECRET=your_secure_otp_salt_secret_key
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password_or_smtp_password
SMTP_FROM=noreply@sahayog.in

# Cloudinary (Media / Attachment Uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
