# Port configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Local or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/sahayog_db
# For MongoDB Atlas, use:
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/sahayog_db?retryWrites=true&w=majority

# JWT Authentication Secret & Expiration
JWT_SECRET=sahayog_secret_jwt_key_2026
JWT_EXPIRES_IN=7d

# Email Verification & OTP Settings
OTP_EXPIRES_MINUTES=10
OTP_COOLDOWN_SECONDS=60

# Google OAuth Client Credentials
GOOGLE_CLIENT_ID=329999526959-u8d56469i0dhpa01ruv80ih4nc2q3sjk.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=

# Frontend Client URL
CLIENT_URL=http://localhost:5173

# Gemini / AI API Key
GEMINI_API_KEY=
AI_API_KEY=

# Cloudinary Configuration for Image Uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
