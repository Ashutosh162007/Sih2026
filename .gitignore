# ==============================================================================
# Sahayog (सहयोग) — Master Root .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Sensitive Credentials (Never Commit to Git)
# ------------------------------------------------------------------------------
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# ------------------------------------------------------------------------------
# 2. Node & JavaScript Dependencies (Frontend & Backend)
# ------------------------------------------------------------------------------
node_modules/
jspm_packages/
.pnp
.pnp.js

# ------------------------------------------------------------------------------
# 3. Build & Distribution Outputs
# ------------------------------------------------------------------------------
dist/
dist-ssr/
build/
out/
.vite/
*.local

# ------------------------------------------------------------------------------
# 4. Python & AI Engine (Virtual Environments & Bytecode)
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# ------------------------------------------------------------------------------
# 5. Logs & Runtime Storage
# ------------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.eslintcache

# Storage / User Uploads (Keep directory with .gitkeep)
Storage/uploads/*
!Storage/uploads/.gitkeep

# ------------------------------------------------------------------------------
# 6. Operating System & IDE Artifacts
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Editors
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?