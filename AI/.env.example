# ==============================================================================
# Sahayog AI Microservice — Environment Configuration (.env)
# ==============================================================================

# Server Port for FastAPI AI microservice
PORT=8000

# ------------------------------------------------------------------------------
# NVIDIA NIM AI Configuration
# ------------------------------------------------------------------------------
# Get your NVIDIA API key from: https://build.nvidia.com/
NVIDIA_API_KEY=nvapi-your_nvidia_api_key_here

# NVIDIA NIM Model name (OpenAI-compatible / LangChain NVIDIA endpoint)
# Popular choices:
# - meta/llama-3.3-70b-instruct (Recommended default)
# - nvidia/llama-3.1-nemotron-70b-instruct
# - meta/llama-3.1-405b-instruct
# - mistralai/mixtral-8x22b-instruct-v0.1
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# Optional MongoDB URI if connecting directly from Python scripts
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/sahayog_db?retryWrites=true&w=majority
